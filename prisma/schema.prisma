// Prisma Schema for Foodiq
// Runtime DB access uses raw SQL (pg). This schema mirrors production tables
// for typing, migrations, and tooling compatibility.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  Pending
  Paid
  Preparing
  Out_for_Delivery @map("Out for Delivery")
  Delivered
  Cancelled
}

model User {
  id              String          @id @default(uuid())
  email           String          @unique
  fullName        String          @map("full_name")
  mobile          String?         @map("phone_number")
  passwordHash    String          @map("password_hash")
  isPhoneVerified Boolean         @default(false) @map("is_phone_verified")
  isDeleted       Boolean         @default(false) @map("is_deleted")
  role            String          @default("customer")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at")
  orders          Order[]
  payments        Payment[]
  supportTickets  SupportTicket[]
  chatRooms       ChatRoom[]
  invoices        Invoice[]
  transactions    PaymentTransaction[]
  refunds         Refund[]

  @@map("users")
}

model Order {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  status          OrderStatus     @default(Pending)
  subtotal        Float           @default(0.0)
  discountAmount  Float           @default(0.0) @map("discount_amount")
  deliveryFee     Float           @default(0.0) @map("delivery_fee")
  platformFee     Float           @default(0.0) @map("platform_fee")
  taxAmount       Float           @default(0.0) @map("tax_amount")
  total           Float           @map("total_amount")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at")

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment        Payment?
  supportTickets SupportTicket[]
  invoices       Invoice[]
  transactions   PaymentTransaction[]
  refunds        Refund[]

  @@map("orders")
}

model Payment {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  orderId           String   @unique @map("order_id")
  amount            Float
  paymentMethod     String   @map("method")
  transactionId     String?  @map("razorpay_payment_id")
  razorpayOrderId   String?  @map("razorpay_order_id")
  razorpaySignature String?  @map("razorpay_signature")
  status            String   @default("pending")
  currency          String   @default("INR")
  transactionTime   DateTime? @map("transaction_time")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  order        Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds      Refund[]
  invoices     Invoice[]
  transactions PaymentTransaction[]

  @@map("payments")
}

model PaymentTransaction {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  orderId           String?  @map("order_id")
  paymentId         String?  @map("payment_id")
  razorpayOrderId   String   @unique @map("razorpay_order_id")
  razorpayPaymentId String?  @map("razorpay_payment_id")
  razorpaySignature String?  @map("razorpay_signature")
  amount            Float
  currency          String   @default("INR")
  paymentMethod     String?  @map("payment_method")
  status            String   @default("created")
  checkoutPayload   Json     @default("{}") @map("checkout_payload")
  receipt           String?
  failureReason     String?  @map("failure_reason")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@map("payment_transactions")
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique @map("invoice_number")
  orderId       String   @map("order_id")
  paymentId     String   @unique @map("payment_id")
  userId        String   @map("user_id")
  amount        Float
  taxAmount     Float    @default(0) @map("tax_amount")
  currency      String   @default("INR")
  status        String   @default("issued")
  issuedAt      DateTime @default(now()) @map("issued_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model Refund {
  id               String   @id @default(uuid())
  paymentId        String   @map("payment_id")
  orderId          String   @map("order_id")
  userId           String   @map("user_id")
  amount           Float
  reason           String?
  status           String   @default("processed")
  razorpayRefundId String?  @map("razorpay_refund_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refunds")
}

model SupportTicket {
  id          String   @id @default(uuid())
  ticketId    String   @unique @map("ticket_id")
  userId      String   @map("user_id")
  orderId     String?  @map("order_id")
  category    String
  subject     String
  description String
  imageUrl    String?  @map("image_url")
  status      String   @default("open")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("support_tickets")
}

model ChatRoom {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  status    String    @default("active")
  createdAt DateTime  @default(now()) @map("created_at")
  messages  Message[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_rooms")
}

model Testimonial {
  id              String   @id @default(uuid())
  userId          String?  @map("user_id")
  orderId         String?  @map("order_id")
  restaurantId    String?  @map("restaurant_id")
  restaurantName  String?  @map("restaurant_name")
  dishName        String?  @map("dish_name")
  city            String?
  rating          Int
  reviewText      String   @map("review_text")
  userName        String?  @map("user_name")
  profileImageUrl String?  @map("profile_image_url")
  status          String   @default("pending")
  helpfulCount    Int      @default(0) @map("helpful_count")
  isFeatured      Boolean  @default(false) @map("is_featured")
  orderDate       DateTime? @map("order_date")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  images   ReviewImage[]
  votes    HelpfulVote[]
  reports  ReportedReview[]

  @@map("testimonials")
}

model ReviewImage {
  id            String   @id @default(uuid())
  testimonialId String   @map("testimonial_id")
  imageUrl      String   @map("image_url")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")

  testimonial Testimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)

  @@map("review_images")
}

model HelpfulVote {
  id            String   @id @default(uuid())
  testimonialId String   @map("testimonial_id")
  userId        String   @map("user_id")
  createdAt     DateTime @default(now()) @map("created_at")

  testimonial Testimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)

  @@unique([testimonialId, userId])
  @@map("helpful_votes")
}

model ReportedReview {
  id            String   @id @default(uuid())
  testimonialId String   @map("testimonial_id")
  reporterId    String?  @map("reporter_id")
  reason        String
  status        String   @default("open")
  adminNotes    String?  @map("admin_notes")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  testimonial Testimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)

  @@map("reported_reviews")
}

model DeliveryReferral {
  id                String   @id @default(uuid())
  referrerPartnerId String?  @map("referrer_partner_id")
  referredPartnerId String?  @map("referred_partner_id")
  referralCode      String   @unique @map("referral_code")
  status            String   @default("pending")
  rewardAmount      Float    @default(500.00) @map("reward_amount")
  rewardType        String   @default("cash") @map("reward_type")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([referrerPartnerId])
  @@index([referredPartnerId])
  @@index([referralCode])
  @@index([status])
  @@index([createdAt])
  @@map("delivery_referrals")
}

model DeliveryReferralReward {
  id                   String    @id @default(uuid())
  partnerId            String    @map("partner_id")
  referralId           String    @map("referral_id")
  amount               Float
  walletTransactionId String?   @map("wallet_transaction_id")
  status               String    @default("credited")
  creditedAt           DateTime? @map("credited_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  @@index([partnerId])
  @@index([referralId])
  @@index([status])
  @@index([createdAt])
  @@map("delivery_referral_rewards")
}

model DeliveryReferralSettings {
  id                    String   @id @default(uuid())
  defaultRewardAmount   Float    @default(500.00) @map("default_reward_amount")
  rewardType            String   @default("cash") @map("reward_type")
  expiryDays            Int      @default(30) @map("expiry_days")
  minDeliveriesRequired Int      @default(1) @map("min_deliveries_required")
  autoCreditEnabled     Boolean  @default(true) @map("auto_credit_enabled")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("delivery_referral_settings")
}

model DriverSupportTicket {
  id            String    @id @default(uuid())
  ticketNumber  String    @unique @map("ticket_number")
  partnerId     String    @map("partner_id")
  subject       String
  category      String?
  priority      String    @default("medium")
  status        String    @default("open")
  assignedAdmin String?   @map("assigned_admin")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  closedAt      DateTime? @map("closed_at")

  messages SupportMessage[]
  logs     SupportTicketLog[]

  @@index([partnerId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("support_tickets")
}

model SupportMessage {
  id            String   @id @default(uuid())
  ticketId      String   @map("ticket_id")
  senderType    String   @map("sender_type")
  senderId      String   @map("sender_id")
  message       String?
  attachmentUrl String?  @map("attachment_url")
  messageType   String   @default("text") @map("message_type")
  isRead        Boolean  @default(false) @map("is_read")
  createdAt     DateTime @default(now()) @map("created_at")

  ticket DriverSupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([createdAt])
  @@map("support_messages")
}

model SupportTicketLog {
  id          String   @id @default(uuid())
  ticketId    String   @map("ticket_id")
  action      String
  performedBy String?  @map("performed_by")
  oldStatus   String?  @map("old_status")
  newStatus   String?  @map("new_status")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  ticket DriverSupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([createdAt])
  @@map("support_ticket_logs")
}

model DeliverySyncLog {
  id           String   @id @default(uuid())
  partnerId    String   @map("partner_id")
  syncType     String   @map("sync_type")
  entityType   String   @map("entity_type")
  entityId     String?  @map("entity_id")
  payload      Json     @default("{}")
  syncStatus   String   @default("pending") @map("sync_status")
  retryCount   Int      @default(0) @map("retry_count")
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([partnerId])
  @@index([syncStatus])
  @@index([createdAt])
  @@map("delivery_sync_logs")
}

model DispatchRule {
  id                        String   @id @default(uuid())
  ruleName                  String   @unique @default("default_scoring") @map("rule_name")
  weightDistance            Float    @default(25.0) @map("weight_distance")
  weightGps                 Float    @default(10.0) @map("weight_gps")
  weightOnlineStatus        Float    @default(10.0) @map("weight_online_status")
  weightShiftStatus         Float    @default(10.0) @map("weight_shift_status")
  weightKyc                 Float    @default(10.0) @map("weight_kyc")
  weightFraudScore          Float    @default(10.0) @map("weight_fraud_score")
  weightWorkload            Float    @default(10.0) @map("weight_workload")
  weightVehicle             Float    @default(5.0) @map("weight_vehicle")
  weightAvgDeliveryTime     Float    @default(5.0) @map("weight_avg_delivery_time")
  weightAcceptanceRate      Float    @default(5.0) @map("weight_acceptance_rate")
  weightCompletionRate      Float    @default(5.0) @map("weight_completion_rate")
  weightRating              Float    @default(10.0) @map("weight_rating")
  weightGeofence            Float    @default(10.0) @map("weight_geofence")
  weightTrafficDelay        Float    @default(5.0) @map("weight_traffic_delay")
  weightEstimatedArrival    Float    @default(5.0) @map("weight_estimated_arrival")
  weightIdleTime            Float    @default(5.0) @map("weight_idle_time")
  maxSearchRadiusKm         Float    @default(15.0) @map("max_search_radius_km")
  maxActiveOrdersPerPartner Int      @default(2) @map("max_active_orders_per_partner")
  autoAssignEnabled         Boolean  @default(true) @map("auto_assign_enabled")
  maxRetryAttempts          Int      @default(3) @map("max_retry_attempts")
  reassignTimeoutSeconds    Int      @default(45) @map("reassign_timeout_seconds")
  isActive                  Boolean  @default(true) @map("is_active")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("dispatch_rules")
}

model DispatchLog {
  id               String   @id @default(uuid())
  dispatchRunId    String   @map("dispatch_run_id")
  orderId          String   @map("order_id")
  partnerId        String?  @map("partner_id")
  totalScore       Float    @map("total_score")
  scoringBreakdown Json     @default("{}") @map("scoring_breakdown")
  decisionReason   String   @map("decision_reason")
  status           String   @default("calculated")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([dispatchRunId])
  @@index([orderId])
  @@index([partnerId])
  @@map("dispatch_logs")
}

model DispatchHistory {
  id                  String   @id @default(uuid())
  dispatchRunId       String   @unique @map("dispatch_run_id")
  orderId             String   @map("order_id")
  assignedPartnerId   String?  @map("assigned_partner_id")
  triggerType         String   @default("auto") @map("trigger_type")
  attemptNumber       Int      @default(1) @map("attempt_number")
  status              String   @default("assigned")
  candidatesEvaluated Int      @default(0) @map("candidates_evaluated")
  aiDecisionSummary   String?  @map("ai_decision_summary")
  executionTimeMs     Int      @default(0) @map("execution_time_ms")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([assignedPartnerId])
  @@index([createdAt])
  @@map("dispatch_history")
}

model DeliveryPartner {
  id                   String    @id @default(uuid())
  userId               String?   @map("user_id")
  fullName             String?   @map("full_name")
  email                String?   @unique
  phoneNumber          String?   @unique @map("phone_number")
  passwordHash         String?   @map("password_hash")
  vehicleType          String?   @map("vehicle_type")
  vehicleNumber        String?   @map("vehicle_number")
  vehicleDetails       String?   @map("vehicle_details")
  drivingLicenseNumber String?   @map("driving_license_number")
  licenseNumber        String?   @map("license_number")
  aadhaarNumber        String?   @map("aadhaar_number")
  profilePhoto         String?   @map("profile_photo")
  profilePhotoUrl      String?   @map("profile_photo_url")
  vehiclePhotoUrl      String?   @map("vehicle_photo_url")
  licensePhotoUrl      String?   @map("license_photo_url")
  vehicleRcUrl         String?   @map("vehicle_rc_url")
  insuranceDocUrl      String?   @map("insurance_doc_url")
  city                 String?
  state                String?
  address              String?
  isVerified           Boolean   @default(false) @map("is_verified")
  isOnline             Boolean   @default(false) @map("is_online")
  isAvailable          Boolean   @default(false) @map("is_available")
  status               String    @default("pending")
  approvalStatus       String    @default("approved") @map("approval_status")
  rating               Float     @default(5.0)
  walletBalance        Float     @default(0.0) @map("wallet_balance")
  currentLat           Float?    @map("current_lat")
  currentLng           Float?    @map("current_lng")
  bankAccountName      String?   @map("bank_account_name")
  bankAccountNumber    String?   @map("bank_account_number")
  bankIfsc             String?   @map("bank_ifsc")
  upiId                String?   @map("upi_id")
  aadhaarLast4         String?   @map("aadhaar_last4")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([isOnline])
  @@index([isAvailable])
  @@map("delivery_partners")
}




